# =============================================================================
# SentinelAI - environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---- Flask ----------------------------------------------------------------
FLASK_ENV=development            # development | production | testing
SECRET_KEY=replace-with-a-long-random-string
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true

# ---- Database --------------------------------------------------------------
# SQLite default (instance/database.db). For MySQL (Module 2) use:
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/sentinel?charset=utf8mb4
# DATABASE_URL=

# ---- Mail ------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@sentinel.local

# ---- Security --------------------------------------------------------------
SESSION_COOKIE_SECURE=false       # true when HTTPS is enabled
SESSION_TIMEOUT_MINUTES=30
